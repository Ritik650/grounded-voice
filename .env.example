# All optional -- the defaults run fully offline with no keys.

# Copy to .env (gitignored) and fill in. Never commit a real key.

# extractive (default, no key) | gemini | ollama
LLM_BACKEND=extractive

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-2.0-flash is shut down and gemini-2.5-flash 404s for new keys.
# Current Flash line, fastest first: gemini-3.5-flash-lite (~730 ms to first token),
# gemini-3.5-flash (~850 ms, better reasoning), gemini-3.6-flash (~2.9 s).
GEMINI_MODEL=gemini-3.5-flash-lite
# 0 turns off "thinking" (halves latency where supported); -1 leaves the model
# default. Automatically dropped for models that reject the parameter.
GEMINI_THINKING_BUDGET=0

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# tiny.en | base.en (default) | small.en -- see the WER/latency table in the README
ASR_MODEL_SIZE=base.en

# ":memory:" (default) or http://localhost:6333 for a persistent Qdrant
QDRANT_URL=:memory:

# End-of-utterance hangover; raise if the assistant cuts you off mid-thought
VAD_MIN_SILENCE_MS=600
