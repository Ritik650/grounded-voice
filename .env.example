# All optional -- the defaults run fully offline with no keys.

# extractive (default, no key) | gemini | ollama
LLM_BACKEND=extractive
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# tiny.en | base.en (default) | small.en -- see the WER/latency table in the README
ASR_MODEL_SIZE=base.en

# ":memory:" (default) or http://localhost:6333 for a persistent Qdrant
QDRANT_URL=:memory:

# End-of-utterance hangover; raise if the assistant cuts you off mid-thought
VAD_MIN_SILENCE_MS=600
